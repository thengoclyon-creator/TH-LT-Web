@model WebsiteBanHang.Models.Order
@{
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <h2>Chi tiết Đơn hàng <span class="text-primary">#@Model.Id</span> (Admin)</h2>
    <a asp-action="Index" class="btn btn-secondary mb-3">Quay lại danh sách</a>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">Cập nhật Trạng thái</div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Trạng thái hiện tại</label>
                            <select name="status" class="form-select">
                                <option value="Chờ xử lý" selected="@(Model.Status == "Chờ xử lý")">Chờ xử lý</option>
                                <option value="Đã xác nhận" selected="@(Model.Status == "Đã xác nhận")">Đã xác nhận</option>
                                <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                                <option value="Hoàn thành" selected="@(Model.Status == "Hoàn thành")">Hoàn thành</option>
                                <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Cập nhật</button>
                    </form>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header bg-light">Thông tin khách hàng</div>
                <div class="card-body">
                    <p><strong>Tên:</strong> @Model.User?.FullName</p>
                    <p><strong>Email:</strong> @Model.User?.Email</p>
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Phương thức thanh toán:</strong> 
                        @if(Model.PaymentMethod == "Chuyển khoản") {
                            <span class="badge bg-info text-dark"><i class="fas fa-qrcode me-1"></i>Chuyển khoản</span>
                        } else {
                            <span class="badge bg-secondary"><i class="fas fa-money-bill-wave me-1"></i>Thu hộ (COD)</span>
                        }
                    </p>
                    <p><strong>Địa chỉ giao:</strong> @Model.ShippingAddress</p>
                    <p><strong>Ghi chú:</strong> @Model.Notes</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-light">Sản phẩm</div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@item.Product?.Name</td>
                                    <td>@item.Price.ToString("#,##0") VNĐ</td>
                                    <td>@item.Quantity</td>
                                    <td class="fw-bold">@((item.Price * item.Quantity).ToString("#,##0")) VNĐ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng tiền hàng:</td>
                                <td class="fw-bold fs-6">@((Model.TotalPrice - Model.ShippingFee).ToString("#,##0")) VNĐ</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Phí giao hàng:</td>
                                <td class="fw-bold fs-6 text-success">+ @Model.ShippingFee.ToString("#,##0") VNĐ</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5">Tổng thanh toán:</td>
                                <td class="text-danger fw-bold fs-5">@Model.TotalPrice.ToString("#,##0") VNĐ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
