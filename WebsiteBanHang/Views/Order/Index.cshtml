@model IEnumerable<WebsiteBanHang.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container mt-5 mb-5">
    <h2 class="mb-4">Đơn hàng của tôi</h2>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có đơn hàng nào. <a asp-controller="Home" asp-action="Index">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger fw-bold">@order.TotalPrice.ToString("#,##0") VNĐ</td>
                            <td>
                                @if (order.Status == "Chờ xử lý")
                                {
                                    <span class="badge bg-warning text-dark">@order.Status</span>
                                }
                                else if (order.Status == "Đã xác nhận" || order.Status == "Đang giao")
                                {
                                    <span class="badge bg-primary">@order.Status</span>
                                }
                                else if (order.Status == "Hoàn thành")
                                {
                                    <span class="badge bg-success">@order.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@order.Status</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
