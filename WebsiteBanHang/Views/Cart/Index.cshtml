@model List<WebsiteBanHang.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng";
}

<div class="container mt-5 mb-5">
    <h2>Giỏ hàng của bạn</h2>
    <hr />

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống. <a href="/">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%">Hình ảnh</th>
                        <th style="width: 30%">Tên sản phẩm</th>
                        <th style="width: 15%">Giá</th>
                        <th style="width: 15%">Số lượng</th>
                        <th style="width: 15%">Thành tiền</th>
                        <th style="width: 10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid rounded" style="max-height: 80px;" />
                                }
                                else
                                {
                                    <span>Không có ảnh</span>
                                }
                            </td>
                            <td>@item.ProductName</td>
                            <td>@item.Price.ToString("#,##0") VNĐ</td>
                            <td>
                                <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" class="d-flex align-items-center">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" style="width: 70px;" onchange="this.form.submit()" />
                                </form>
                            </td>
                            <td class="text-danger fw-bold">@item.Total.ToString("#,##0") VNĐ</td>
                            <td>
                                <a asp-action="Remove" asp-controller="Cart" asp-route-productId="@item.ProductId" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold fs-5">Tổng tiền:</td>
                        <td colspan="2" class="text-danger fw-bold fs-5">
                            @Model.Sum(x => x.Total).ToString("#,##0") VNĐ
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="/" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
            <div>
                <a asp-action="Clear" asp-controller="Cart" class="btn btn-outline-danger me-2" onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?');">Xóa giỏ hàng</a>
                <a asp-action="Checkout" asp-controller="Cart" class="btn btn-success">Tiến hành thanh toán</a>
            </div>
        </div>
    }
</div>
