@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container text-center mt-5 mb-5 py-5">
    <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
    <h2 class="mt-4 fw-bold text-success">Đặt hàng thành công!</h2>
    <p class="lead text-muted mt-3">Cảm ơn bạn đã mua sắm tại MyStore. Đơn hàng của bạn đang chờ xử lý.</p>
    
    <div class="mt-4">
        <a asp-controller="Order" asp-action="Index" class="btn btn-primary me-2">Xem đơn hàng của tôi</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
    </div>
</div>
