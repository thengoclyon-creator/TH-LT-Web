@using WebsiteBanHang.Repositories
@inject IProductRepository ProductRepo

@{
    ViewData["Title"] = "Trang Chủ";
    var products = ProductRepo.GetAllProducts();
}

<h2 class="mb-4 border-bottom pb-2 fw-bold text-dark">Sản phẩm nổi bật</h2>

<div class="product-grid">
    @if (products != null && products.Any())
    {
        @foreach (var item in products.Take(6))
        {
            <div class="card h-100 product-card">
                <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="overflow-hidden text-center bg-light">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name">
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height: 220px;">
                            <i class="fas fa-image fa-3x text-muted opacity-50"></i>
                        </div>
                    }
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                        <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="text-decoration-none text-dark product-title">@item.Name</a>
                    </h5>
                    <p class="card-text text-muted small">@item.Description</p>
                    <h5 class="text-danger mt-auto mb-0 fw-bold">@item.Price?.ToString("N0") VNĐ</h5>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 w-100">
            <p class="text-muted">Chưa có sản phẩm nào.</p>
        </div>
    }
</div>

<div class="text-center mt-4">
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">Xem tất cả sản phẩm <i class="fas fa-arrow-right ms-1"></i></a>
</div>
