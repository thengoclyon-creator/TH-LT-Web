@model WebsiteBanHang.Models.Category

@{
    ViewData["Title"] = "Xóa Danh mục";
}

<h2 class="mb-4 border-bottom pb-2 fw-bold text-dark">Xác nhận Xóa Danh Mục</h2>

<div class="alert alert-danger shadow-sm">
    <h4><i class="fas fa-exclamation-triangle"></i> Bạn có chắc chắn muốn xóa danh mục này không?</h4>
    <hr>
    <dl class="row mt-3">
        <dt class="col-sm-3">ID danh mục</dt>
        <dd class="col-sm-9">#@Model.Id</dd>

        <dt class="col-sm-3">Tên danh mục</dt>
        <dd class="col-sm-9">@Model.Name</dd>
    </dl>
    
    <form asp-action="Delete" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger px-4">Xác nhận Xóa</button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Hủy</a>
    </form>
</div>
