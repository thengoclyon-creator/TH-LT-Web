@model IEnumerable<WebsiteBanHang.Models.Category>

@{
    ViewData["Title"] = "Danh sách Danh mục";
}

<h2 class="mb-4">Danh sách Danh mục</h2>

<table class="table table-bordered table-striped table-hover" style="max-width: 600px;">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Tên Danh mục</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
            </tr>
        }
    </tbody>
</table>
